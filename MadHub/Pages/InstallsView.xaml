<UserControl x:Class="MadHub.InstallsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MadHub"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Installs" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Locate" Width="80" Height="34" Margin="0,0,12,0" Background="#2D2D2D" Foreground="White" BorderThickness="0"/>
                <Button Content="Install Editor" Width="110" Height="34" Background="#1F60A5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="All" Foreground="White" FontWeight="SemiBold" Margin="0,0,20,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <ItemsControl Grid.Row="2" ItemsSource="{Binding InstalledVersions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#252526" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>   
                                <ColumnDefinition Width="Auto"/> 
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Path Data="M 16,2 L 30,10 L 30,22 L 16,30 L 2,22 L 2,10 Z" Stroke="#8A8A8A" StrokeThickness="1.5" Fill="#2D2D2D"/>
                                <Path Data="M 16,2 L 16,16 M 16,16 L 30,10 M 16,16 L 2,10 M 16,16 L 16,30" Stroke="#8A8A8A" StrokeThickness="1"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Version}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    
                                    <Border Margin="8,0,0,0" Background="#3E3E42" CornerRadius="2" Padding="4,1" VerticalAlignment="Center"
                                            Visibility="{Binding IsLts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="LTS" Foreground="#A0A0A0" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding Path}" Foreground="#757575" FontSize="12" Margin="0,4,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding Platforms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding}" Foreground="#969696" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.08L14.47,2.42C14.43,2.18 14.22,2 13.97,2H9.97C9.72,2 9.51,2.18 9.47,2.42L9.08,5.08C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.96 4.4,5.05 4.29,5.27L2.29,8.73C2.17,8.95 2.22,9.22 2.41,9.37L4.52,11C4.47,11.34 4.45,11.67 4.45,12C4.45,12.33 4.47,12.65 4.52,12.97L2.41,14.63C2.22,14.78 2.17,15.05 2.29,15.27L4.29,18.73C4.4,18.95 4.67,19.04 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.08,18.92L9.47,21.58C9.51,21.82 9.72,22 9.97,22H13.97C14.22,22 14.43,21.82 14.47,21.58L14.86,18.92C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                                      Fill="#A0A0A0" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
