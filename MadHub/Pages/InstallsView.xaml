<UserControl x:Class="MadHub.InstallsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MadHub"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=local:InstallsViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Installs" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Locate" Width="80" Height="34" Margin="0,0,12,0" Background="#2D2D2D" Foreground="White" BorderThickness="0" Click="LocateEditor_Click"/>
                <Button Content="Install Editor" Width="110" Height="34" Background="#1F60A5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="All" Foreground="White" FontWeight="SemiBold" Margin="0,0,20,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <ItemsControl Grid.Row="2" ItemsSource="{Binding EditorManifests}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:EditorManifestData}">
                    <Border Background="#252526" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>   
                                <ColumnDefinition Width="Auto"/> 
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Path Data="M 16,2 L 30,10 L 30,22 L 16,30 L 2,22 L 2,10 Z" Stroke="#8A8A8A" StrokeThickness="1.5" Fill="#2D2D2D"/>
                                <Path Data="M 16,2 L 16,16 M 16,16 L 30,10 M 16,16 L 2,10 M 16,16 L 16,30" Stroke="#8A8A8A" StrokeThickness="1"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Version}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    
                                    <Border Margin="8,0,0,0" Background="#3E3E42" CornerRadius="2" Padding="4,1" VerticalAlignment="Center"
                                            Visibility="{Binding IsLts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="LTS" Foreground="#A0A0A0" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding PathToExecutable}" Foreground="#757575" FontSize="12" Margin="0,4,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding Platforms}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D2D30" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding }" Foreground="#969696" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="MenuButton_Click">
                                <Path Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" 
                                      Fill="#A0A0A0" Stretch="Uniform" Width="14" Height="14"/>

                                <Button.ContextMenu>
                                    <ContextMenu
                                        Background="#2D2D30"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        Padding="0">

                                        <ContextMenu.Template>
                                            <ControlTemplate TargetType="ContextMenu">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">

                                                    <ItemsPresenter
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ContextMenu.Template>

                                        <ContextMenu.Resources>

                                            <Style TargetType="MenuItem">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="14,7"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="MenuItem">
                                                            <Border
                                                                x:Name="MenuBorder"
                                                                Background="{TemplateBinding Background}"
                                                                SnapsToDevicePixels="True">

                                                                <ContentPresenter
                                                                    ContentSource="Header"
                                                                    Margin="{TemplateBinding Padding}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter
                                                                        TargetName="MenuBorder"
                                                                        Property="Background"
                                                                        Value="#3E3E42"/>
                                                                </Trigger>

                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                        </ContextMenu.Resources>

                                        <MenuItem Header="Open in file explorer" Click="OpenInExplorer_Click"/>

                                        <MenuItem Header="Remove" Foreground="#FF5555" Click="RemoveInstall_Click"/>

                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
